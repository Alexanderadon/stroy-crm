# Copy to .env.local and fill in. Never commit .env.local.

# Public values: they end up in the browser bundle, access is enforced by the database.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Secret key: used only by local scripts (scripts/seed.ts).
# It must never get the VITE_ prefix, or Vite will put it into the browser bundle.
SUPABASE_SECRET_KEY=
